# Supabase — use Transaction pooler on Vercel (port 6543), NOT direct db.*:5432
# Example: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Prefer DATABASE_URL; POSTGRES_URL is only a legacy fallback when DATABASE_URL is unset.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres

# Apple App Store Server API + product IDs (must match App Store Connect / iOS SubscriptionStore)
APPLE_BUNDLE_ID=come.aidol.aidol
APPLE_ISSUER_ID=your-apple-issuer-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\\nreplace-with-your-app-store-connect-private-key\\n-----END PRIVATE KEY-----
APPLE_ENVIRONMENT=production
APPLE_MONTHLY_PRODUCT_ID=aidol.membership.monthly
APPLE_YEARLY_PRODUCT_ID=aidol.membership.yearly

# LLM proxy (OpenAI-compatible)
# Overseas deployment: DashScope international compatible-mode endpoint
LLM_API_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-openai-compatible-api-key
LLM_API_BASE_URL_MAINLAND=https://api.deepseek.com
LLM_API_BASE_URL_OVERSEAS=https://api.deepseek.com
LLM_API_KEY_MAINLAND=your-mainland-deepseek-api-key
LLM_API_KEY_OVERSEAS=your-overseas-deepseek-api-key
LLM_MODEL_MAINLAND=deepseek-v4-flash
LLM_MODEL_OVERSEAS=deepseek-v4-flash
LLM_MODEL=deepseek-v4-flash
# Optional scenario split:
# chat defaults to qwen-flash
# theater defaults to qwen-flash
# voice_letter keeps a stronger model for scheduled generation stability
AI_TEXT_MODEL_CHAT=deepseek-v4-flash
AI_TEXT_MODEL_THEATER=deepseek-v4-flash
AI_TEXT_MODEL_THEATER_STAGE_BEAT=deepseek-v4-flash
AI_TEXT_MODEL_VOICE_LETTER=deepseek-v4-flash
# Optional stronger-model alias if you want to keep the old naming style
AI_TEXT_MODEL_STRONG=deepseek-v4-flash

# Mainland deployment: DeepSeek V4 Flash
# LLM_API_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=your-deepseek-api-key
# LLM_MODEL=deepseek-v4-flash
# AI_TEXT_MODEL_CHAT=deepseek-v4-flash
# AI_TEXT_MODEL_THEATER=deepseek-v4-flash
# AI_TEXT_MODEL_THEATER_STAGE_BEAT=deepseek-v4-flash
# AI_TEXT_MODEL_VOICE_LETTER=deepseek-v4-flash
# AI_TEXT_MODEL_STRONG=deepseek-v4-flash

# DashScope voice clone + TTS
DASHSCOPE_API_KEY_MAINLAND=your-mainland-qwen-voice-api-key
DASHSCOPE_API_BASE_URL_MAINLAND=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_API_KEY_OVERSEAS=your-overseas-qwen-voice-api-key
DASHSCOPE_API_BASE_URL_OVERSEAS=https://dashscope-intl.aliyuncs.com/api/v1
# china = dashscope.aliyuncs.com (default; use with China console API key)
# intl = dashscope-intl.aliyuncs.com (only if your key is from the international console)
DASHSCOPE_REGION=china
DASHSCOPE_TTS_VC_MODEL=qwen3-tts-vc-2026-01-22
# Optional: raise defaults if cross-region latency is high (milliseconds)
# DASHSCOPE_CONNECT_TIMEOUT_MS=60000
# DASHSCOPE_HEADERS_TIMEOUT_MS=120000
# DASHSCOPE_BODY_TIMEOUT_MS=120000

# Optional quotas (defaults shown; values below code floors are ignored)
# Free tier floors in lib/membership.ts: chat 20, tts 5
FREE_DAILY_CHAT_LIMIT=20
FREE_DAILY_TTS_LIMIT=5
FREE_MONTHLY_VOICE_CLONE_LIMIT=3
FREE_THEATER_PARTNER_REPLY_LIMIT=15
MEMBER_DAILY_CHAT_LIMIT=200
MEMBER_DAILY_TTS_LIMIT=100
MEMBER_DAILY_THEATER_LIMIT=5
MEMBER_THEATER_PARTNER_REPLY_LIMIT=15
MEMBER_MONTHLY_VOICE_CLONE_LIMIT=10

# Apple App Store Server API timeouts (milliseconds)
APPLE_CONNECT_TIMEOUT_MS=15000
APPLE_HEADERS_TIMEOUT_MS=25000
APPLE_BODY_TIMEOUT_MS=25000
